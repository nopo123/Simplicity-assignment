{
  "name": "announcements-backend",
  "version": "1.0.0",
  "description": "Announcements API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,test,database}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,database}/**/*.ts\" --fix",
    "test": "jest --runInBand --selectProjects=unit --selectProjects=e2e",
    "test:unit": "jest --selectProjects=unit --runInBand",
    "test:e2e": "jest --selectProjects=e2e --runInBand",
    "test:cov": "npm run test -- --coverage",
    "seed": "ts-node -r tsconfig-paths/register src/seed/command-seed.ts",
    "seed:prod": "node dist/src/seed/command-seed.js",
    "typeorm": "ts-node --require tsconfig-paths/register ./node_modules/typeorm/cli",
    "migration:run": "npm run typeorm migration:run -- -d ./database/typeorm.config.ts",
    "migration:run:prod": "typeorm migration:run -d dist/database/typeorm.config.js",
    "migration:generate": "npm run typeorm -- -d ./database/typeorm.config.ts migration:generate ./database/migrations/%npm_config_name%",
    "migration:create": "npm run typeorm -- migration:create ./database/migrations/%npm_config_name%",
    "migration:revert": "npm run typeorm -- -d ./database/typeorm.config.ts migration:revert",
    "migration:show": "npm run typeorm -- migration:show -d ./database/typeorm.config.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.22",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dayjs": "^1.11.20",
    "dotenv": "^16.4.7",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.29",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "rootDir": ".",
    "verbose": true,
    "coverageDirectory": "./coverage",
    "collectCoverageFrom": [
      "src/**/*.{js,ts}"
    ],
    "projects": [
      "<rootDir>/test/jest-unit.json",
      "<rootDir>/test/jest-e2e.json"
    ]
  }
}
