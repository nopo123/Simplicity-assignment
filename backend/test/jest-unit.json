{
  "displayName": "unit",
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": "-test.*\.unit\.spec\.ts$",
  "transform": {
    "^.+\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^database/(.*)$": "<rootDir>/database/$1",
    "^test/(.*)$": "<rootDir>/test/$1"
  },
  "setupFiles": ["<rootDir>/test/jest.setup.js"]
}
