{
  "displayName": "e2e",
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^database/(.*)$": "<rootDir>/database/$1",
    "^test/(.*)$": "<rootDir>/test/$1"
  },
  "setupFiles": ["<rootDir>/test/jest.setup.js"],
  "detectOpenHandles": false,
  "testTimeout": 30000
}
